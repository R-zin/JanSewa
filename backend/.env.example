# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/govservices

# Redis
REDIS_URL=redis://redis:6379/0

# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=gov-services-documents

# Google AI
GOOGLE_API_KEY=your_google_api_key

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# DigiLocker
DIGILOCKER_CLIENT_ID=your_digilocker_client_id
DIGILOCKER_CLIENT_SECRET=your_digilocker_client_secret
DIGILOCKER_REDIRECT_URI=http://localhost:8000/api/v1/digilocker/callback
